# ---------------------------------------------------------------------------
# Global Entry Strategy Studio — variables de entorno
# Copie este fichero a .env y rellene los valores. Nunca suba .env al repositorio.
# ---------------------------------------------------------------------------

# URL pública de la aplicación. Fija el redirect_uri del login y evita depender
# de las cabeceras del proxy. En local: http://localhost:3000
PUBLIC_URL=https://su-dominio

# Base de datos MySQL o TiDB
DATABASE_URL=mysql://usuario:contrasena@host:3306/base

# Secreto con el que se firma la cookie de sesión. Mínimo 32 caracteres.
# Genérelo con: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# --- Acceso ---------------------------------------------------------------
# Credenciales de OAuth de Google Cloud Console. El URI de redirección
# autorizado debe ser exactamente  <PUBLIC_URL>/api/auth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Correos autorizados, separados por comas. Sin esta lista no entra nadie.
# El primero de la lista recibe rol de administrador.
ALLOWED_EMAILS=usted@ejemplo.com

# --- Modelo de lenguaje ---------------------------------------------------
# API de chat completions compatible con OpenAI. Puede apuntar a otro proveedor.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=

# --- Almacenamiento de documentos de caso ---------------------------------
# S3 o compatible. Para Cloudflare R2 rellene S3_ENDPOINT; para S3 nativo déjelo vacío.
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Refresco programado de datos públicos --------------------------------
# Secreto que el programador de tareas envía en la cabecera X-Cron-Secret.
# Sin él, el endpoint queda cerrado.
CRON_SECRET=
